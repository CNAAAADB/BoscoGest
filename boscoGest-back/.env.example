# Copy to .env and fill in. NEVER commit .env — it is git-ignored on purpose.

# ──────────────────────────────────────────────
# Database (required — no fallback, the app refuses to start without it)
# ──────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg2://admin:admin123@localhost:5432/boscogest

# Engine tuning (optional, sensible defaults in app/config.py)
SQLALCHEMY_ECHO=false
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800
DB_POOL_TIMEOUT=30

# ──────────────────────────────────────────────
# JWT authentication (required)
# ──────────────────────────────────────────────
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
# Minimum 32 characters. Well-known placeholders are rejected at startup.
SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ──────────────────────────────────────────────
# CORS (required — comma-separated, wildcard '*' is rejected)
# ──────────────────────────────────────────────
CORS_ORIGINS=http://localhost:4200,http://localhost

# ──────────────────────────────────────────────
# File uploads
# ──────────────────────────────────────────────
STORAGE_BACKEND=local
UPLOAD_DIR=uploads
# Only needed when STORAGE_BACKEND=s3
S3_BUCKET_NAME=boscogest-uploads-prod

# ──────────────────────────────────────────────
# Email (AWS SES)
# ──────────────────────────────────────────────
AWS_REGION=eu-west-1
# Verified SES identity used as the From address. Empty = welcome emails are
# skipped with a warning (useful for local development).
SES_SENDER_EMAIL=
# Optional: SES configuration set for bounce/complaint event tracking
SES_CONFIGURATION_SET=
# Root URL of the web app, used in the links inside outgoing emails
APP_BASE_URL=http://localhost:4200

# ──────────────────────────────────────────────
# Notificaciones push (Firebase Cloud Messaging)
# ──────────────────────────────────────────────
# Vacías = no se envía ningún push y queda un aviso en el log. La aplicación
# funciona entera sin esto: push es un canal más, no el que sostiene nada.
#
# FCM_CREDENTIALS_FILE apunta al JSON de la cuenta de servicio que se descarga
# de la consola de Firebase. NUNCA se commitea. En local, por ejemplo
# deploy/firebase-service-account.json (ignorado por git); en producción,
# /run/secrets/firebase-service-account.json, donde lo monta
# deploy/docker-compose.prod.yml.
FCM_PROJECT_ID=
FCM_CREDENTIALS_FILE=
