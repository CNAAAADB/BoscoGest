# Database
# Local development
DATABASE_URL=postgresql+psycopg2://admin:admin123@localhost:5432/boscogest

# Docker (uses service name from docker-compose)
DATABASE_URL_DOCKER=postgresql+psycopg2://admin:admin123@db:5432/boscogest

# JWT Authentication
# IMPORTANT: Change SECRET_KEY in production to a secure random string (min 32 chars)
SECRET_KEY=your-super-secret-key-change-this-in-production-minimum-32-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# File Uploads
UPLOAD_DIR=uploads
STORAGE_BACKEND=local

# S3 (only needed when STORAGE_BACKEND=s3)
S3_BUCKET_NAME=boscogest-uploads-prod
AWS_REGION=eu-west-1

# CORS (comma-separated list of allowed origins)
# Add your production domain here (replace IP with yours)
CORS_ORIGINS=http://localhost:4200,http://localhost,http://localhost:80,http://front,http://YOUR-EC2-IP,http://YOUR-EC2-IP:80
