# Copy to .env.build and set the deployment target. Not versioned.
#
# environment.prod.ts is generated from this by scripts/set-environment.mjs,
# which every production build runs first.

# Base domain. Yields https://api.<domain> and wss://api.<domain>.
APP_DOMAIN=boscogest.es

# Only needed when the API does not live at api.<domain>.
# API_URL=https://api.boscogest.es
# WS_URL=wss://api.boscogest.es

# Allows http:// and ws:// — for local testing against a plain-HTTP backend.
# Never set this for a real deployment.
# ALLOW_INSECURE=1
